# ─────────────────────────── Telegram Bot
# Токен бота от @BotFather
BOT_TOKEN=

# ID администраторов через запятую (целые числа, без @)
ADMIN_IDS=

# Username канала/чата поддержки (без @), для кнопки «Поддержка»
SUPPORT_USERNAME=

# ─────────────────────────── Telegram API (для Telethon-парсинга)
# Получить на https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ─────────────────────────── CryptoBot (оплата подписки в USDT)
# Токен от @CryptoBot → Crypto Pay → Create App
CRYPTOBOT_TOKEN=

# ─────────────────────────── База данных
# По умолчанию SQLite в текущей папке. Можно заменить на PostgreSQL:
# postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///bot.db

# ─────────────────────────── Observability
# Порт для /healthz и /metrics (используется Docker HEALTHCHECK)
OBSERVABILITY_PORT=8080
